# ═══════════════════════════════════════════════════════════════════
# PLANTILLA DE CONFIGURACIÓN DEL FRAMEWORK
# Copiar a .env.qa o .env.cert y completar con los valores reales.
# Ninguno de estos archivos debe versionarse en git.
# ═══════════════════════════════════════════════════════════════════

# ── Aplicación bajo prueba ──────────────────────────────────────────
BASE_URL=https://tu-ambiente.ejemplo.com
ENV=qa

# ── Herramienta de gestión de proyectos ────────────────────────────
# TAG_PREFIX controla el formato del tag que se escribe en los .feature:
#   jira     → @jira:KAN-21   (default)
#   testrail → @testrail:C123
#   azure    → @azure:WI-456
TAG_PREFIX=jira

# ── Jira Cloud (si JIRA_ENABLED=true) ──────────────────────────────
JIRA_ENABLED=true
JIRA_BASE_URL=https://tu-empresa.atlassian.net
JIRA_EMAIL=qa@tu-empresa.com
JIRA_API_TOKEN=token_de_jira_aqui
JIRA_PROJECT_KEY=PROJ
JIRA_PARENT_ISSUE_KEY=PROJ-1
JIRA_EPIC_KEY=PROJ-2
JIRA_EXECUTOR_NAME=NombreDelQA

# ── Campos adicionales del issue (opcionales) ───────────────────────
# accountId del usuario asignado por defecto a los issues creados.
# Si está vacío, el issue queda sin asignar.
JIRA_ASSIGNEE_ACCOUNT_ID=

# URL del sprint al que se asociarán los issues (campo customfield_10062).
# Ejemplo: https://tu-empresa.atlassian.net/browse/PROJ-29
JIRA_SPRINT_URL=

# ID del equipo en Atlassian Teams (campo customfield_10001).
# Ejemplo: abf4be3f-1bef-473d-a313-b09238580bdf
JIRA_TEAM_ID=

# Días a sumar desde la fecha del run para la fecha de vencimiento.
# Dejar vacío para no establecer fecha de vencimiento.
JIRA_DUE_DATE_DAYS=7

# Tipo de issue para bugs (default: Task).
# Cambiar a "Bug" si el proyecto Jira tiene ese tipo disponible.
JIRA_BUG_ISSUE_TYPE=Task

# ── Prioridad de bugs ──────────────────────────────────────────────
# Tipo de ejecución: development | release | regression
# Controla la prioridad asignada a los bugs creados automáticamente:
#   release/regression + @smoke → QA_PRIORITY_CRITICAL
#   release/regression          → QA_PRIORITY_HIGH
#   development + @smoke        → QA_PRIORITY_HIGH
#   development                 → QA_PRIORITY_MEDIUM
QA_RUN_TYPE=development

# Nombres de prioridad en Jira (deben coincidir exactamente con los configurados en el proyecto).
# Dejar vacío para usar los valores en inglés por defecto.
QA_PRIORITY_CRITICAL=Highest
QA_PRIORITY_HIGH=High
QA_PRIORITY_MEDIUM=Medium

# ── Comportamiento del agente ───────────────────────────────────────
# true  → fallos de framework no crean tarea: el agente corrige el código
# false → crea Tarea de Refactorización en Jira (default)
QA_AGENT_MODE=false

# true  → limpia el case-registry.dat al inicio del sync (útil para empezar desde cero)
# Cambiar a false después de la primera ejecución para no perder los mapeos
JIRA_RESET_REGISTRY=false
